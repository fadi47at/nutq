{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nutq",
  "version": "0.4.0",
  "identifier": "com.nutq.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "nutq",
        "width": 1100,
        "height": 760,
        "minWidth": 400,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' data: blob:; connect-src 'self' https://github.com https://*.github.com https://*.githubusercontent.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1NDhCNkU3QjkzNzQzQjcKUldTM1F6ZTU1N1pJcGQ1Z1NaVnJSWnNncjdVUXJIYncyYSs0ZzFuRC9ZTWJYZ2lFVDRRakxXYlMK",
      "endpoints": [
        "https://github.com/fadi47at/nutq/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "publisher": "Fadi",
    "shortDescription": "Voice in, finished text out.",
    "longDescription": "Press a hotkey anywhere in Windows, speak, and get finished text pasted where you were typing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
